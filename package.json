{
  "name": "project-forge",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "dev": "nx run-many -t dev",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nx-dotnet/core": "^3.0.2",
    "@nx/next": "^23.1.1",
    "@orval/swr": "^8.23.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "nx": "23.1.1",
    "orval": "^8.23.0",
    "prettier": "^3.2.0",
    "swr": "^2.4.2",
    "typescript-eslint": "^8.0.0"
  }
}