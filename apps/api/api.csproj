<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.1" />
  </ItemGroup>

  <!-- Generate OpenAPI Spec on Build -->
  <Target Name="GenerateOpenApiSpec" AfterTargets="Build">
    <MakeDir Directories="../../packages/types" />
    <Exec Command="dotnet tool restore" />
    <Exec Command="dotnet tool run swagger tofile --output &quot;../../packages/types/openapi.json&quot; &quot;$(TargetPath)&quot; v1" EnvironmentVariables="ASPNETCORE_ENVIRONMENT=SwaggerGen" />
  </Target>

</Project>
