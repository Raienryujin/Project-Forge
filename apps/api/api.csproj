<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.1" />
  </ItemGroup>

  <!-- Generate OpenAPI Spec on Build -->
  <Target Name="GenerateOpenApiSpec" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="../../packages/types" />
    <Exec Command="dotnet swagger tofile --output ../../packages/types/openapi.json $(OutputPath)$(AssemblyName).dll v1" />
  </Target>

</Project>
