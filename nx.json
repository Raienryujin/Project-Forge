{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": ["@nx-dotnet/core"],
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/.next/**",
        "!{projectRoot}/.next/cache/**",
        "{projectRoot}/bin/**",
        "{projectRoot}/obj/**"
      ]
    },
    "@nx-dotnet/core:serve": {
      "dependsOn": ["build"]
    },
    "generate-api": {
      "dependsOn": ["api:build"]
    }
  }
}
